# These are read by the website's server only. They are never sent to the browser,
# so do NOT add a NEXT_PUBLIC_ prefix to them.

# Backend API base URL, including /api (optional, default shown)
BACKEND_API_URL=http://localhost:8000/api

# Must match API_KEY in the backend's .env (required)
BACKEND_API_KEY=your-api-key-here
